# AffiForge Environment Configuration (Copy to .env and fill in real values)

# ===== LLM APIs =====
# OpenAI API Key (for GPT-4o cluster generation)
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude 3.5 Sonnet optimization)
CLAUDE_API_KEY=...

# ===== External Services =====
# Serper API Key (SERP data + low-competition validation)
SERPER_API_KEY=...

# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_KEY=...
AMAZON_PAAPI_SECRET=...
AMAZON_PAAPI_REGION=us-east-1

# Reddit API (for Reddit Scanner)
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=AffiForge/1.2 (by @yourusername)

# ===== WordPress Integration =====
# WordPress Application Password (per-site, obtained from WordPress admin)
# Stored encrypted in database; this is template only
WORDPRESS_APP_PASSWORD=...

# ===== Payment Processing =====
# Stripe Secret Key (for subscription billing & payouts)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ===== Database =====
# PostgreSQL connection string
# Format: postgresql://[user[:password]@][host][:port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/affiforge

# ===== Cache & Queuing =====
# Redis connection string (for Celery broker, rate-limiting, session cache)
# Format: redis://[username:password@]host[:port]/[db]
REDIS_URL=redis://localhost:6379/0

# ===== Supabase (Auth + Encryption Keys) =====
# Supabase Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Anon Key (public, for client-side requests)
SUPABASE_ANON_KEY=eyJhbGc...

# Supabase Service Key (server-only, for admin operations like RLS bypass)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ===== Application Configuration =====
# Environment: development | staging | production
ENVIRONMENT=development

# FastAPI secret key (for session/JWT signing)
SECRET_KEY=your-secret-key-here-min-32-chars

# JWT token expiration (seconds)
JWT_EXPIRATION_SECONDS=3600

# ===== Cost Controls =====
# Maximum cost per LLM task (in USD)
MAX_COST_PER_TASK=0.12

# ===== Email Configuration (Optional, for newsletters) =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== Celery Beat Schedule =====
# Timezone for scheduled tasks
CELERY_TIMEZONE=UTC

# ===== Logging =====
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=https://...@sentry.io/...

# ===== CORS & Security =====
# Allowed frontend origin(s) for CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===== Feature Flags =====
# Enable revenue-share calculations (Elite tier)
ENABLE_REVENUE_SHARE=true

# Enable Celery background tasks (disable for testing)
ENABLE_CELERY_TASKS=true

# ===== AWS (Optional) =====
# AWS Access Key & Secret (for S3 backup, if enabled)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
