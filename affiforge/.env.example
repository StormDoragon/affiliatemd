# Loopback-only local demo. Set the values in the production runbook before exposing it.
ENVIRONMENT=development
DEMO_MODE=true
ALLOW_REGISTRATION=true
APP_ORIGIN=http://localhost:3000
CADDY_SITE=http://localhost
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_HTTP_PORT=3000
PUBLISH_HTTPS_PORT=3443

# Use a new, URL-safe password for production. The same value is used for the database connection.
POSTGRES_PASSWORD=local-demo-only
JWT_SECRET_KEY=local-demo-only-never-use-in-production
CREDENTIAL_ENCRYPTION_KEY=

# Optional provider credentials. Demo mode uses local examples and disables live billing.
OPENAI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AffiForge/0.2
STRIPE_SECRET_KEY=
STRIPE_PRICE_IDS=
